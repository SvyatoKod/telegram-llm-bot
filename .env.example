# Ollama (default: http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b

# Polling long-poll timeout in seconds (Telegram side)
TELEGRAM_POLL_TIMEOUT_SEC=30

# Max parallel LLM requests handled by the bot
MAX_CONCURRENCY=4

# Max messages stored per user (history size limit)
COUNT_MESSAGE_LIMIT=10

# When history grows beyond this size, it will be summarized and replaced by a short summary message
COUNT_MESSAGE_SUMMARY_LIMIT=6

# System prompt (model behavior)
SYSTEM_PROMPT=Ты пионер вожатый, который приветствует и говорит с другими пионерами. Ты хочешь помочь другим и, если не знаешь ответ, то говоришь "Я не знаю товарищ".